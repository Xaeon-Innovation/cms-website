# Canonical site URL (no trailing slash) — SEO, sitemap, Open Graph, JSON-LD
# Use either form below; avoid nesting quotes inside the value (e.g. not '"https://..."').
NEXT_PUBLIC_SITE_URL=https://www.creativemultisolutions.com

# Optional search console verification (content values only, add <meta> via layout when set)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-auth-domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-storage-bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# VPS media hosting (see deploy/media-server/README.md)
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com
MEDIA_UPLOAD_SECRET=generate-a-long-random-secret
# Optional overrides (defaults: BASE/upload and BASE/files)
# MEDIA_UPLOAD_URL=https://media.example.com/upload
# MEDIA_DELETE_URL=https://media.example.com/files

# Optional video URL overrides (otherwise Firestore settings/media + local /assets fallbacks)
# NEXT_PUBLIC_VIDEO_HERO_URL=
# NEXT_PUBLIC_VIDEO_MEDICAL_MARKETING_URL=
# NEXT_PUBLIC_VIDEO_DIGITAL_MARKETING_URL=
# NEXT_PUBLIC_VIDEO_EVENTS_ORGANISING_URL=
